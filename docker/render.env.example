# =============================================================================
# Mẫu biến môi trường cho Render (Environment -> Add from .env)
# THAY toàn bộ giá trị YOUR-... / THAY_... bằng thông tin thật. KHÔNG commit giá trị thật.
# =============================================================================

# --- Ứng dụng ---
APP_NAME="Cay Canh Shop"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-SERVICE.onrender.com
# Tạo 1 lần ở máy: php artisan key:generate --show   (giữ cố định qua các lần deploy)
APP_KEY=base64:THAY_BANG_APP_KEY_DA_TAO
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# --- Proxy của Render (để Laravel nhận ra HTTPS) ---
TRUSTED_PROXIES=*

# --- MySQL trên Aiven ---
DB_CONNECTION=mysql
DB_HOST=YOUR-AIVEN-HOST.aivencloud.com
DB_PORT=YOUR-AIVEN-PORT
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=THAY_BANG_MAT_KHAU_AIVEN
# Secret File tên ca.pem -> Render gắn vào /etc/secrets/ca.pem
MYSQL_ATTR_SSL_CA=/etc/secrets/ca.pem

# --- Phiên đăng nhập / cache / queue ---
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Khởi tạo ---
RUN_MIGRATIONS=true
# Bật true CHO LẦN ĐẦU để tạo admin, thành công rồi đổi lại false
RUN_SEEDERS=false
ADMIN_NAME="Shop Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=THAY_BANG_MAT_KHAU_RIENG_TOI_THIEU_12_KY_TU
# true = chạy schedule:work trong container (huỷ đơn quá hạn, đồng bộ GHN, tự hoàn thành đơn)
RUN_SCHEDULER=true

# --- Mail ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Cay Canh Shop"

# --- Chuyển khoản ngân hàng ---
BANK_NAME=Vietcombank
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
BANK_BRANCH=

# --- MoMo (môi trường test) ---
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_VERIFY_SSL=true
MOMO_REDIRECT_URL=https://YOUR-SERVICE.onrender.com/momo/callback
MOMO_IPN_URL=https://YOUR-SERVICE.onrender.com/momo/ipn

# --- GHN (môi trường dev) ---
# BẮT BUỘC cho API tính phí (/v2/shipping-order/fee): GHN_SHOP_ID + GHN_FROM_DISTRICT_ID
# (+ nên có GHN_FROM_WARD_CODE). Thiếu thì Tỉnh/Quận/Phường vẫn tải được (chỉ cần
# Token) nhưng checkout báo "Không tính được phí". Đổi biến trên Render phải
# redeploy vì entrypoint chạy config:cache.
GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=
# Mẫu: shop dev của dự án; lấy đúng ShopId trong trang quản lý cửa hàng GHN.
GHN_SHOP_ID=216463
GHN_VERIFY_SSL=true
# Mẫu: Quận Bắc Từ Liêm (tra qua master-data/district)
GHN_FROM_DISTRICT_ID=1482
# Mẫu: Phường Phú Diễn (tra qua master-data/ward?district_id=1482)
GHN_FROM_WARD_CODE=11007
GHN_WEBHOOK_TOKEN=

# --- Đăng nhập Google (Socialite) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-SERVICE.onrender.com/auth/google/callback
